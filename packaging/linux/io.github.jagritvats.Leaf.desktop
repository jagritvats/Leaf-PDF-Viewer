[Desktop Entry]
Type=Application
Name=Leaf
GenericName=PDF Editor
Comment=Edit, sign and redact PDF files on your computer
Exec=leaf %F
Icon=io.github.jagritvats.Leaf
Terminal=false
Categories=Office;Viewer;Graphics;
MimeType=application/pdf;
Keywords=PDF;editor;sign;signature;redact;form;OCR;annotate;
StartupNotify=true
StartupWMClass=leaf
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=leaf --new-window
