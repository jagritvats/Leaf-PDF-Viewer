    </screenshot>
    <screenshot>
      <caption>Edit existing text in the document's own font</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/03-edit-text-1920x1080.png</image>
    </screenshot>
    <screenshot>
      <caption>Redact sensitive information for real</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/05-redact-1920x1080.png</image>
    </screenshot>
    <screenshot>
      <caption>Fill in and sign forms</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/02-forms-1920x1080.png</image>
    </screenshot>
    <screenshot>
      <caption>Digital signatures with your own certificate</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/06-digital-signature-1920x1080.png</image>
    </screenshot>
    <screenshot>
      <caption>Make scanned pages searchable with OCR</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/07-ocr-1920x1080.png</image>
    </screenshot>
    <screenshot>
      <caption>Reorder, rotate and extract pages</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/jagritvats/Leaf-PDF-Viewer/main/marketing/out/screens/light/04-organize-pages-1920x1080.png</image>
