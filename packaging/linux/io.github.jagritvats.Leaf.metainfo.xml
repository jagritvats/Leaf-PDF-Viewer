  <branding>
    <color type="primary" scheme_preference="light">#8fd6a0</color>
    <color type="primary" scheme_preference="dark">#1f6b33</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <releases>
    <release version="0.2.0" date="2026-11-18">
      <description>
        <p>A new look that follows Windows 11 and your accent color, a start screen that shows your recent files as
        page previews, and Focus mode (Ctrl+Shift+F) for distraction-free reading.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-18">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
